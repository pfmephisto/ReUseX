tests/fixtures/**/*.pcd filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.db filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.db3 filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.e57 filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.h5 filter=lfs diff=lfs merge=lfs -text
