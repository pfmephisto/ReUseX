<RCC version="1.0">
  <!-- The release snapshot of the theme: tokens.css (vendored from
       rux-frontend's src/tokens.css via scripts/sync-tokens.sh) and the QSS
       template. The gallery and app in dev mode read both from the source
       tree instead and hot-reload. -->
  <qresource prefix="/rux_qt">
    <file alias="tokens.css">../theme/tokens.css</file>
    <file alias="styles/app.qss">../styles/app.qss</file>
    <file>fonts/Archivo-Regular.ttf</file>
    <file>fonts/Archivo-Italic.ttf</file>
    <file>fonts/Archivo-Medium.ttf</file>
    <file>fonts/Archivo-SemiBold.ttf</file>
    <file>fonts/Oswald-Medium.ttf</file>
    <file>fonts/Oswald-SemiBold.ttf</file>
    <file>fonts/JetBrainsMono-Regular.ttf</file>
    <file>fonts/JetBrainsMono-Medium.ttf</file>
  </qresource>
</RCC>
