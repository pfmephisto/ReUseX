+        // ReUseX patch sentinel: ruxd refuses to compile without this patch.
+#define CROW_REUSEX_HEADER_CHECK 1
+
+        /// ReUseX patch: a check run once a request's headers are parsed and
+        /// before its body is read. Return false to refuse the request; the
+        /// response it filled in is sent and the connection closed. Unset (the
+        /// default) accepts everything. Middleware still runs afterwards for
+        /// accepted requests, so it must not rely on this having run.
+        using header_check_handler = std::function<bool(const request&, response&)>;
+
+        /// ReUseX patch: install the header-phase check (see above).
+        self_t& header_check(header_check_handler handler)
+        {
+            header_check_ = std::move(handler);
+            return *this;
+        }
+
+        /// ReUseX patch: run the header-phase check (http_connection.h).
+        bool check_headers(const request& req, response& res)
+        {
+            return !header_check_ || header_check_(req, res);
+        }
