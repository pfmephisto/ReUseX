         {
+            // ReUseX patch: a header-phase check (Crow::header_check) runs once
+            // the headers are in and before the body is read, so a request it
+            // refuses (say, an unauthenticated upload) never gets its body
+            // buffered. A refusal is written synchronously and the connection
+            // is closed: the unread body makes it unusable for keep-alive.
+            // Only for a request that found a route: handle_url has already
+            // answered one that did not (404) and must not be answered twice.
+            req_.remote_ip_address = adaptor_.address();
+            if ((routing_handle_result_->rule_index || routing_handle_result_->catch_all) &&
+                !handler_->check_headers(req_, res))
+            {
+                close_connection_ = true;
+                add_keep_alive_ = false;
+                need_to_call_after_handlers_ = false;
+                complete_request();
+                return false;
+            }
             // HTTP 1.1 Expect: 100-continue
             if (req_.http_ver_major == 1 && req_.http_ver_minor == 1 && get_header_value(req_.headers, "expect") == "100-continue")
